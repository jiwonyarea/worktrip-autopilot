# Copy to .env and fill in. Restart `npm run dev` after changing.
#
# Only VITE_-prefixed vars reach the browser bundle. The anon key is designed
# to be public (RLS protects the data). Never put a service role key or an
# Anthropic/Amadeus key here — those are edge function secrets, set with
# `supabase secrets set` (see README).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
